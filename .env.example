# MongoDB
MONGODB_URI=mongodb://localhost:27017/requisition-management

# JWT Configuration
JWT_SECRET=your_jwt_secret
JWT_COOKIE_EXPIRE=12

# Server Configuration
PORT=3001
NODE_ENV=development

# Intranet Configuration
INTRANET_BYPASS=iGNOre
INTRANET_AUTH_URL=https://daystarng.org/

# AWS S3 Configuration
AWS_S3_REGION=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BASE_URL=

# Optional static credentials (omit when using IAM role/instance profile)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email Configuration
EMAIL_HOST=your_email_host
EMAIL_PORT=587
EMAIL_SECURE=true
EMAIL_USER=your_email_user
EMAIL_PASSWORD=your_email_password
EMAIL_FROM_NAME="Requisition Pro"
EMAIL_FROM_ADDRESS=your_email_address

# Notifications
NOTIFY_EMAIL_ENABLED=true
# Base URL used in deep links inside emails (pick one)
APP_URL=http://localhost:3000
# or
# FRONTEND_URL=http://localhost:3000

# Optional WebSockets (requires `npm i socket.io` to enable)
ENABLE_WEBSOCKETS=false
WS_CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Optional Queue (requires `npm i bullmq` and a running Redis)
ENABLE_QUEUES=false
REDIS_URL=redis://localhost:6379